{
  "expo": {
    "name": "SITREP",
    "slug": "sitrep-claim-journal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mellemnick.sitrep",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3E5A28",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mellemnick.sitrep"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "sitrep",
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-document-picker",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SITREP uses Face ID to keep your journal locked."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3E5A28"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#ECEEE5",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#12160F"
          }
        }
      ]
    ]
  }
}
